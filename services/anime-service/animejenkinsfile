pipeline {

    agent {
        docker {
            image 'python:3.12-slim'
            reuseNode true
           args '-u root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }
   parameters {
        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: false,
            description: 'Run unit tests'
        )
    }
     environment {
        SERVICE_DIR = 'services/anime-service'
        IMAGE_NAME = 'nuthan22/pyanimese'
        DOCKER_CREDENTIALS = 'dockerhub-credentials'
    }

    stages {
       stage('Install Dependencies') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate

                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }

       stage('Unit Test') {
    when {
        expression {
            params.RUN_TESTS
        }
    }

    steps {
        dir("${SERVICE_DIR}") {
            sh '''
                . venv/bin/activate
                pytest
            '''
        }
    }
}

        stage('Application Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh '''
                        . venv/bin/activate
                        python -m compileall .
                    '''
                }
            }
        }
     stage('Install Docker CLI') {
    steps {
        sh '''
            apt-get update
            apt-get install -y docker.io
            docker --version
        '''
    }
}
 stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                        -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                        ${SERVICE_DIR}

                    docker tag \
                        ${IMAGE_NAME}:${BUILD_NUMBER} \
                        ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Docker Image Test') {
            steps {
                sh '''
                    docker image inspect ${IMAGE_NAME}:${BUILD_NUMBER}
                    docker image inspect ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                sh '''
                    docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                    docker push ${IMAGE_NAME}:latest
                '''
            }
        }
    }

    post {

        success {
            echo "Anime Service CI completed successfully"
            echo "Image: ${IMAGE_NAME}:${BUILD_NUMBER}"
        }

        failure {
            echo "Anime Service CI failed"
        }
    }
}
